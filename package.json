{
  "name": "gen-platform",
  "version": "1.0.0",
  "private": true,
  "description": "GEN - plataforma premium para fiestas, eventos, boletos QR y control de acceso.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @gen/api\" \"npm run dev -w @gen/web\"",
    "dev:web": "npm run dev -w @gen/web",
    "dev:api": "npm run dev -w @gen/api",
    "dev:staff": "npm run start -w @gen/staff-mobile",
    "dev:user": "npm run start -w @gen/user-mobile",
    "dev:admin-api": "npm run dev -w @admin-finops/backend",
    "dev:admin-web": "npm run dev -w @admin-finops/frontend",
    "build:admin": "npm run build -w @admin-finops/backend && npm run build -w @admin-finops/frontend",
    "db:schema": "node scripts/apply-db.mjs infra/schema.sql",
    "db:seed": "node scripts/apply-db.mjs infra/seed.sql",
    "db:setup": "node scripts/apply-db.mjs infra/schema.sql infra/seed.sql",
    "db:migrate": "npm run db:schema",
    "lint": "npm run lint -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
